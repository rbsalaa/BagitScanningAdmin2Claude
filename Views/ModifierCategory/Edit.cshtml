@model ModifierCategoryDTO

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Category</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Editpost" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ModifierCategoryID" />
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="CompID" class="control-label"></label>
                    <select id="PreferenceType" asp-for="CompID" class="form-control" asp-items="Model.CompList"></select>
                    <span asp-validation-for="CompID" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BrandID" class="control-label"></label>
                    <select asp-for="BrandID" class="form-control PreferenceType2" asp-items="Model.BrandList"></select>
                    <span asp-validation-for="BrandID" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BranchID" class="control-label"></label>
                    <select asp-for="BranchID" class="form-control PreferenceType3" asp-items="Model.BranchList"></select>
                    <span asp-validation-for="BranchID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ModifierCategoryName" class="control-label"></label>
                    <input asp-for="ModifierCategoryName" class="form-control" />
                    <span asp-validation-for="ModifierCategoryName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ModifierCategoryName_AR" class="control-label"></label>
                    <input asp-for="ModifierCategoryName_AR" class="form-control" />
                    <span asp-validation-for="ModifierCategoryName_AR" class="text-danger"></span>
                </div>
              
               
            </div>

         
            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary" asp-controller="ModifierCategory" asp-action="EditPost" />
                | <a class="btn btn-secondary"  asp-action="List">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script type="text/javascript">
    $(document).ready(function () {

        $("#PreferenceType").change(function () {
            $(".PreferenceType2").empty();
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/Category/GetPreferenceValues',
                dataType: 'json',
                data: { id2: $(this).val() },
                success: function (data) {
                    $(".PreferenceType2").append('<option value="">Select Brand</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType2").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });

        $(".PreferenceType2").change(function () {
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/Category/GetPreferenceValues3',
                dataType: 'json',
                data: {
                    id2: $(".PreferenceType2").val(),
                    id3: $("#PreferenceType").val()
                },
                success: function (data) {
                    $(".PreferenceType3").append('<option value="">Select Branch</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType3").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });
    });
</script>