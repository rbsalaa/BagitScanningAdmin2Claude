@model dynamic
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_Notifications" />
<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-body">
              
              

              
                <!-- end row -->
                <div class="table-responsive mb-4">
                    <table class="table table-hover table-nowrap align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th scope="col" style="width: 50px;">
                                   @* <div class="form-check font-size-16">
                                        <input type="checkbox" class="form-check-input" id="contacusercheck">
                                        <label class="form-check-label" for="contacusercheck"></label>
                                    </div>*@
                                </th>
                                <th scope="col">Item Name</th>
                                <th scope="col">Item Price</th>
                                <th scope="col">Group Name</th>
                              
                                <th scope="col" style="width: 200px;">Stauts</th>
                                      <th scope="col" >UnAssign</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.unAssignedItem)
                            {
                                <tr>
                                    <th scope="row">
                                        
                                    </th>
                                    <td>
                                        <img src="~/assets/images/users/avatar-2.jpg" alt="" class="avatar-xs rounded-circle me-2">
                                        <a href="#" class="text-body">@item.ItemName</a>
                                    </td>
                                    <td>@item.ItemPrice</td>
                                    <td>@item.GroupName</td>
                                   
                                   
                                    <td>
                                        <bold>Current Assigned Items</bold>
                                    </td>
                                    <td>
                                        <ul class="list-inline mb-0">
                                            <li class="list-inline-item">
                                                <a asp-action="UnAssignUserToRoleListPost" asp-controller="Modifier" asp-route-userid="@item.ItemID" asp-route-roleid="@Model.categoryID" class="px-2 btn-primary"> UnAssign</a>
                                            </li>

                                        </ul>
                                    </td>
                                </tr>
                            }
                      
                          
                        </tbody>
                    </table>
                </div>
              
              
            </div>
        </div>
    </div>
</div>
<!-- end row -->



@section scripts{


}