<script>
    // Highlights the current page in the sidebar and keeps exactly one section open.
    // The template's own script compares full URLs case-sensitively, so "/users/list" and
    // "/Users/List" did not match and sections could be left open or the wrong link highlighted.
    // Here the classes metisMenu reads (li.mm-active / ul.mm-show) are set consistently,
    // so clicking a section afterwards opens and closes it normally.
    window.addEventListener('load', function () {
        var menu = document.getElementById('side-menu');
        if (!menu) return;
        var norm = function (u) {
            try { return new URL(u, location.origin).pathname.replace(/\/+$/, '').toLowerCase() || '/'; }
            catch (e) { return ''; }
        };
        var here = norm(location.href);
        if (here === '/dashboard' || here === '/dashboard/index') here = '/';
        var best = null, bestLen = -1;
        menu.querySelectorAll('a[href]').forEach(function (a) {
            var h = a.getAttribute('href');
            if (!h || h.indexOf('javascript') === 0) return;
            var p = norm(h);
            var hit = p === here || (p !== '/' && here.indexOf(p + '/') === 0);
            if (hit && p.length > bestLen) { best = a; bestLen = p.length; }
        });
        // Same controller, different action (e.g. Items/edit/5) → highlight the section's first link for that controller.
        if (!best && here !== '/') {
            var ctrl = '/' + here.split('/')[1];
            menu.querySelectorAll('.sub-menu a[href]').forEach(function (a) {
                if (!best && norm(a.getAttribute('href')).indexOf(ctrl + '/') === 0) best = a;
            });
        }
        menu.querySelectorAll('.mm-active').forEach(function (el) { el.classList.remove('mm-active'); });
        menu.querySelectorAll('.mm-show').forEach(function (el) { el.classList.remove('mm-show'); });
        menu.querySelectorAll('a.active').forEach(function (el) { el.classList.remove('active'); });
        if (!best) return;
        best.classList.add('active');
        best.setAttribute('aria-current', 'page');
        var li = best.closest('li');
        li.classList.add('mm-active');
        var sub = li.closest('ul.sub-menu');
        if (sub) {
            sub.classList.add('mm-show');
            sub.setAttribute('aria-expanded', 'true');
            var parentLi = sub.closest('li');
            parentLi.classList.add('mm-active');
            var toggle = parentLi.querySelector(':scope > a');
            if (toggle) toggle.setAttribute('aria-expanded', 'true');
        }
    });
</script>
