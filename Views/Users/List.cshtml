@model CarrierDTO
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
<partial name="_Notifications" />
<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-body">
              
                <div class="row mb-2">
                    <div class="col-md-6">
                       @* <div class="form-inline float-md-start mb-3">
                            <div class="search-box me-2">
                                <div class="position-relative">
                                    <input type="text" class="form-control border" placeholder="Search...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                            </div>
                        </div>*@
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3 float-end">
                            <a class="btn btn-primary" asp-controller="Users" asp-action="create"><i class="bi bi-plus-circle"></i> &nbsp; Add User</a>

                         @*   <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
                                <i class="mdi mdi-plus me-1"></i> Add User
                            </a>*@
                        </div>
                    </div>
                </div>

              
                <!-- end row -->
                <div class="table-responsive mb-4">
                    <table class="table table-hover table-nowrap align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                               
                                <th scope="col">First Name</th>
                                <th scope="col">First Name</th>
                                <th scope="col">Email</th>
                              
                                <th scope="col" style="width: 200px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.UsersList)
                            {
                                <tr>
                                   
                                    <td>
                                        
                                        <a href="#" class="text-body">@item.FirstName</a>
                                    </td>
                                    <td>@item.LastName</td>
                                    <td>@item.Email</td>
                                   
                                    <td>
                                        <ul class="list-inline mb-0">
                                            <li class="list-inline-item">
                                                <a asp-action="Edit" asp-controller="Users" asp-route-id="@item.Id" class="px-2 text-primary"><i class="ri-pencil-line font-size-18"></i></a>
                                            </li>
                                            <li class="list-inline-item">
                                                <a asp-action="Delete" asp-controller="Users" asp-route-id="@item.Id" class="px-2 text-danger"><i class="ri-delete-bin-line font-size-18"></i></a>
                                            </li>
                                          @*  <li class="list-inline-item dropdown">
                                                <a class="dropdown-toggle font-size-18 px-2" href="#" role="button" data-bs-toggle="dropdown" aria-haspopup="true">
                                                    <i class="ri-more-2-fill"></i>
                                                </a>

                                               @* <div class="dropdown-menu dropdown-menu-end">
                                                    <a class="dropdown-item" href="#">Action</a>
                                                    <a class="dropdown-item" href="#">Another action</a>
                                                    <a class="dropdown-item" href="#">Something else here</a>
                                                </div>
                                            </li>*@
                                        </ul>
                                    </td>
                                </tr>
                            }
                      
                          
                        </tbody>
                    </table>
                </div>
              
                @*<div class="row mt-4">
                    <div class="col-sm-6">
                        <div>
                            <p class="mb-sm-0">Showing 1 to 10 of 12 entries</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="float-sm-end">
                            <ul class="pagination mb-sm-0">
                                <li class="page-item disabled">
                                    <a href="#" class="page-link"><i class="mdi mdi-chevron-left"></i></a>
                                </li>
                                <li class="page-item active">
                                    <a href="#" class="page-link">1</a>
                                </li>
                                <li class="page-item">
                                    <a href="#" class="page-link">2</a>
                                </li>
                                <li class="page-item">
                                    <a href="#" class="page-link">3</a>
                                </li>
                                <li class="page-item">
                                    <a href="#" class="page-link"><i class="mdi mdi-chevron-right"></i></a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>*@
            </div>
        </div>
    </div>
</div>
<!-- end row -->




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        function toggleDropdowns(disabled) {
            $("#PreferenceType").prop('disabled', disabled);
            $("#PreferenceType2").prop('disabled', disabled);
            $("#PreferenceType3").prop('disabled', disabled);
            $("#PreferenceType4").prop('disabled', disabled);
        } toggleDropdowns($("#IsRBSUserCheckbox").is(":checked"));

        // Toggle on change
        $("#IsRBSUserCheckbox").change(function () {
            toggleDropdowns($(this).is(":checked"));
        });
        //Dropdownlist Selectedchange event
        $(document).ready(function () {
            //Dropdownlist Selectedchange event
            $("#PreferenceType").change(function () {
                $(".PreferenceType2").empty();
                $.ajax({
                    type: 'POST',
                    url: '/Users/GetPreferenceValues', // we are calling json method
                    dataType: 'json',
                    data: { id2: $("#PreferenceType").val() },
                    success: function (states) {
                        // states contains the JSON formatted list
                        // of states passed from the controller

                        $(".PreferenceType2").append('<option value="' + "0" + '">' + "Select Brand" + '</option>');
                        debugger;
                        $.each(states, function (i, state) {

                            $(".PreferenceType2").append('<option value="' + state.Value + '">' + state.Text + '</option>');
                            // here we are adding option for States
                        });

                    },
                    error: function (ex) {
                        alert('Failed to retrieve states.' + ex);
                    }
                });
                return false;
            })
        });


        $(".PreferenceType3").change(function () {
            $("#FranchID").empty();
            $.ajax({
                type: 'POST',
                url: '/Users/GetPreferenceValues2', // we are calling json method
                dataType: 'json',
                data: { id3: $("#PreferenceType").val(), id2: $(".PreferenceType2").val() },
                success: function (states) {
                    // states contains the JSON formatted list
                    // of states passed from the controller

                    $(".PreferenceType4").append('<option value="' + "NULL" + '">' + "Select Franch" + '</option>');
                    debugger;
                    $.each(states, function (i, state) {

                        $(".PreferenceType4").append('<option value="' + state.Value + '">' + state.Text + '</option>');
                        // here we are adding option for States
                    });

                },
                error: function (ex) {
                    alert('Failed to retrieve states.' + ex);
                }
            });
            return false;
        })

        $("#PreferenceType").change(function () {

            $(".PreferenceType3").empty();

        })
        $(".PreferenceType2").change(function () {
            $("#BranchID").empty();
            $.ajax({
                type: 'POST',
                url: '/Users/GetPreferenceValues3', // we are calling json method
                dataType: 'json',
                data: { id3: $("#PreferenceType").val(), id2: $(".PreferenceType2").val() },
                success: function (states) {
                    // states contains the JSON formatted list
                    // of states passed from the controller
                    $(".PreferenceType3").append('<option value="' + "NULL" + '">' + "Select Branch" + '</option>');

                    debugger;
                    $.each(states, function (i, state) {

                        $(".PreferenceType3").append('<option value="' + state.Value + '">' + state.Text + '</option>');
                        // here we are adding option for States
                    });

                },
                error: function (ex) {
                    alert('Failed to retrieve states.' + ex);
                }
            });
            return false;
        })





    </script>
}