@model IEnumerable<RolesDTO>
@{
    ViewData["Title"] = "Roles List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">Roles List</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary" asp-controller="Users" asp-action="Rolecreate"><i class="bi bi-plus-circle"></i> &nbsp; Add Roles</a>

        </div>

    </div>

    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>


                <th>
                    Roles Name
                </th>


                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.NormalizedName

                    </td>



                    <td class="text-center">
                        <div class="btn-Roles w-75" role="Roles">
                            <a class="btn btn-primary mx-2" asp-controller="Users" asp-action="RolePermissions" asp-route-id="@item.Id"><i class="bi bi-card-list"></i> &nbsp;  Permissions</a>

                            <a class="btn btn-primary mx-2" asp-controller="Users" asp-action="RoleDetail" asp-route-id="@item.Id"><i class="bi bi-card-list"></i> &nbsp; Details</a>

                            <a class="btn btn-secondary  mx-2 " asp-controller="Users" asp-action="RoleEdit" asp-route-id="@item.Id"><i class="bi bi-pencil-fill"></i> &nbsp; Edit</a>

                            <a class="btn btn-warning  mx-2 " asp-controller="Users" asp-action="RoleDelete" asp-route-id="@item.Id"><i class="bi bi-trash-fill"></i> &nbsp; Delete</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>