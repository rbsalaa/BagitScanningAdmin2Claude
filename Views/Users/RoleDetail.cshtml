@model RolesDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">@Model.Name Details</h3>
        </div>
      

    </div>

    </br>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                
                 <th>
                     ID
                </th>
                <th>
                     Role Name
                </th>
                <th>
                    Role NormalizedName
                </th>
                <th>
                    Role ConcurrencyStamp
                </th>
                <th>
                    Role ConcurrencyStamp
                </th>
               

            </tr>
        </thead>
        <tbody>

            <tr>
             
             
                <td style="width:30%">
                    @Model.Id
                </td>
                <td style="width:20%">
                    @Model.Name
                </td>
                <td style="width:20%">
                    @Model.NormalizedName

                </td>
                <td style="width:20%">
                    @Model.ConcurrencyStamp

                </td>
                <td style="width:20%">
                    @Model.ConcurrencyStamp

                </td>
                 
        </tbody>
    </table>
    <a class="btn btn-secondary" asp-action="RolesList">Back to List</a>
</div>
