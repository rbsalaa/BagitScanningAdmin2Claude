@model IEnumerable<RolesDTO>
@{
    ViewData["Title"] = "Roles List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">Roles List</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary" asp-controller="Users" asp-action="Rolecreate"><i class="bi bi-plus-circle"></i> &nbsp; Add Roles</a>

        </div>

    </div>

    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>


                <th>
                    Roles Name
                </th>


                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.NormalizedName

                    </td>



                    <td class="text-center">
                        <div class="btn-Roles w-75" role="Roles">
                            <a class="btn btn-primary mx-2" asp-controller="Users" asp-action="AssignUserToRoleList" asp-route-id="@item.Id"><i class="bi bi-card-list"></i> &nbsp;  Assign Users To Role</a>

                            <a class="btn  btn-primary mx-2" asp-controller="Users" asp-action="RoleCurrentUsersList" asp-route-id="@item.Id"><i class="bi bi-card-list"></i> &nbsp;  Role Current Users Details</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>