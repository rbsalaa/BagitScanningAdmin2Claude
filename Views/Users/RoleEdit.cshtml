@model RolesDTO

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-Role">
                 <div class="form-group">
                <label asp-for="CompID" class="control-label"></label>
                <select id="PreferenceType" asp-for="CompID" class="form-control" asp-items="Model.CompList"></select>
                <span asp-validation-for="CompID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BrandID" class="control-label"></label>
                <select asp-for="BrandID" class="form-control PreferenceType2" asp-items="Model.BrandList"></select>
                <span asp-validation-for="BrandID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BranchID" class="control-label"></label>
                <select asp-for="BranchID" class="form-control PreferenceType3" asp-items="Model.BranchList"></select>
                <span asp-validation-for="BranchID" class="text-danger"></span>
            </div>
                <div class="form-Role">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control"  />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-Role">
                    <label asp-for="NormalizedName" class="control-label"></label>
                    <input asp-for="NormalizedName" class="form-control" />
                    <span asp-validation-for="NormalizedName" class="text-danger"></span>
                </div
                  <div class="form-Role">
                    <label asp-for="ConcurrencyStamp" class="control-label"></label>
                    <input asp-for="ConcurrencyStamp" class="form-control" />
                    <span asp-validation-for="ConcurrencyStamp" class="text-danger"></span>
                </div>
            </div>
            

            <div class="form-Role  pb-3">
                <input type="submit" value="Save" class="btn btn-primary"  asp-controller="Users" asp-action="RoleEditPost" />
                | <a class="btn btn-secondary"  asp-controller="Users"  asp-action="RolesList">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}<script type="text/javascript">
    $(document).ready(function () {

        $("#PreferenceType").change(function () {
            $(".PreferenceType2").empty();
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/Group/GetPreferenceValues',
                dataType: 'json',
                data: { id2: $(this).val() },
                success: function (data) {
                    $(".PreferenceType2").append('<option value="">Select Brand</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType2").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });

        $(".PreferenceType2").change(function () {
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/Group/GetPreferenceValues3',
                dataType: 'json',
                data: {
                    id2: $(".PreferenceType2").val(),
                    id3: $("#PreferenceType").val()
                },
                success: function (data) {
                    $(".PreferenceType3").append('<option value="">Select Branch</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType3").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });
    });
</script>
