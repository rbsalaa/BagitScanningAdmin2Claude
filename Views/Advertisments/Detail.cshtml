@model AdvertismentsDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">General Details</h3>
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.AdsID)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.AdsID)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.AdsTitle)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.AdsTitle)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.AdsURL)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.AdsURL)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.AdsStartDate)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.AdsStartDate)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.AdsEndDate)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.AdsEndDate)
                </dd>
            </dl>
        </div>

        <div class="col-6">
            <h3 class="text-primary">Video Preview</h3>
            @if (!string.IsNullOrEmpty(Model.AdsURL))
            {
                <video width="100%" controls>
                    <source src="@Model.AdsURL" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            }
            else
            {
                <p>No video available</p>
            }
        </div>
    </div>

    <a class="btn btn-secondary" asp-action="AdvertismentsList">Back to List</a>
</div>
