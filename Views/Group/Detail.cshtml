@model GroupDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">@Model.GroupName Details</h3>
        </div>
      

    </div>

    </br>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                
                 <th>
                     ID
                </th>
                <th>
                    group Name 
                </th>
                <th>
                    item price 
                </th>
               
                <th>
                    Is Active 
                </th>
               

            </tr>
        </thead>
        <tbody>

            <tr>
             
             
                <td style="width:30%">
                    @Model.GroupID
                </td>
                <td style="width:20%">
                    @Model.GroupName
                </td>
                <td style="width:20%">
                    @Model.ItemPrice

                </td>
                 
                <td style="width:20%">
                    @Model.IsActive

                </td>
                 
        </tbody>
    </table>
    <a class="btn btn-secondary" asp-action="list">Back to List</a>
</div>
