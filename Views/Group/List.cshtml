@model IEnumerable<GroupDTO>
@{
    ViewData["Title"] = "Group List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">Group List</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary" asp-controller="group" asp-action="create"><i class="bi bi-plus-circle"></i> &nbsp; Add Group</a>

        </div>

    </div>

    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
              
                <th>
                    group ID
                </th>
                <th>
                    group Name 
                </th>
                <th>
                    group  price
             
                <th>
                    Is Active
                </th>

                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td >
                        @item.GroupID

                    </td>
                    <td >
                        @item.GroupName

                    </td>
                    <td >
                        @item.ItemPrice

                    </td>
                    <td>
                        @item.IsActive

                    </td>

                    
                    <td class="text-center">
                        <div class="btn-group w-75" role="Items">
                            <a class="btn btn-primary mx-2"  asp-controller="group" asp-action="Detail" asp-route-id="@item.GroupID"><i class="bi bi-card-list"></i> &nbsp; Group Details</a>

                            <a class="btn btn-secondary  mx-2 " asp-controller="group" asp-action="Edit" asp-route-id="@item.GroupID"><i class="bi bi-pencil-fill"></i> &nbsp; Edit</a>

                            <a class="btn btn-warning  mx-2 " asp-controller="group" asp-action="Delete" asp-route-id="@item.GroupID"><i class="bi bi-trash-fill"></i> &nbsp; Delete</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts {





}