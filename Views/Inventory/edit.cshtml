@model SelfKOrderWeb.DTO.InventoryDTO
@{
    ViewData["Title"] = "Edit Inventory";
}

<div class="container pt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Edit Inventory</h4>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Inventory" asp-action="editPost">
                @Html.AntiForgeryToken()
                <input asp-for="InvID" type="hidden" />

                <div class="mb-3">
                    <label class="form-label">Inventory ID</label>
                    <input value="@Model.InvID" class="form-control" disabled />
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label asp-for="InvName" class="form-label">Inventory Name</label>
                        <input asp-for="InvName" class="form-control" />
                        <span asp-validation-for="InvName" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label asp-for="InvName_AR" class="form-label">الاسم بالعربية</label>
                        <input asp-for="InvName_AR" class="form-control" dir="rtl" />
                        <span asp-validation-for="InvName_AR" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="InvLocation" class="form-label">Location</label>
                    <input asp-for="InvLocation" class="form-control" />
                    <span asp-validation-for="InvLocation" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label asp-for="CompID" class="form-label">Company</label>
                        <select asp-for="CompID" asp-items="@Model.CompList" class="form-select" id="CompID">
                            <option value="">-- Select Company --</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-4">
                        <label asp-for="BrandID" class="form-label">Brand</label>
                        <select asp-for="BrandID" asp-items="@Model.BrandList" class="form-select" id="BrandID">
                            <option value="">-- Select Brand --</option>
                        </select>
                    </div>
                   @*  <div class="mb-3 col-md-4">
                        <label asp-for="BranchID" class="form-label">Branch</label>
                        <select asp-for="BranchID" asp-items="@Model.BranchList" class="form-select" id="BranchID">
                            <option value="">-- Select Branch --</option>
                        </select>
                    </div> *@
                </div>

                <div class="mb-3 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Is Active</label>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary w-100">Update</button>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Inventory" asp-action="InventoryList" class="btn btn-outline-secondary w-100">Back To List</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('#CompID').change(function () {
                var compId = $(this).val();
                $('#BrandID').empty().append('<option value="">-- Select Brand --</option>');
                // $('#BranchID').empty().append('<option value="">-- Select Branch --</option>');
                if (!compId) return;

                $.ajax({
                    type: "POST",
                    url: "/Inventory/GetPreferenceValues",
                    data: { id2: compId },
                    success: function (data) {
                        $.each(data, function (i, item) {
                            $('#BrandID').append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                    }
                });
            });

            

        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}