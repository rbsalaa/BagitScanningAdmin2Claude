@model SelfKOrderWeb.DTO.InventoryDTO
@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="container pt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Inventory</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning">
                Are you sure you want to delete this inventory? This action can not be undone.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Inventory ID</dt>
                <dd class="col-sm-9">@Model.InvID</dd>

                <dt class="col-sm-3">Inventory Name</dt>
                <dd class="col-sm-9">@Model.InvName</dd>

                <dt class="col-sm-3">الاسم بالعربية</dt>
                <dd class="col-sm-9" dir="rtl">@Model.InvName_AR</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.InvLocation</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Last Modified</dt>
                <dd class="col-sm-9">@Model.LastModified.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>

            <form method="post" asp-controller="Inventory" asp-action="deletePOST" asp-route-id="@Model.InvID">
                @Html.AntiForgeryToken()
                <div class="row mt-4">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-controller="Inventory" asp-action="InventoryList" class="btn btn-outline-secondary w-100">Back To List</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>