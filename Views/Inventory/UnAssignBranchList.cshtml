@model InvBranchDTO
@{
    ViewBag.Title = "UnAssign Branches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_Notifications" />

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">Current Assigned Branches : @Model.invName</h4>
                <div class="table-responsive mb-4">
                    <table class="table table-hover table-nowrap align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th scope="col" style="width: 50px;"></th>
                                <th scope="col">Branch Name</th>
                                <th scope="col" style="width: 200px;">UnAssign</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var branch in Model.assignedBranch)
                            {
                                <tr>
                                    <th scope="row"></th>
                                    <td>
                                        <a href="#" class="text-body">@branch.BranchName</a>
                                    </td>
                                    <td>
                                        <a asp-action="UnAssignBranchPost" asp-controller="Inventory"
                                           asp-route-BranchID="@branch.BranchID"
                                           asp-route-InvID="@Model.invID"
                                           class="px-2 btn btn-sm btn-danger">UnAssign</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
}