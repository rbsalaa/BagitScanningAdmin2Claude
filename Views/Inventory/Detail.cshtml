@model SelfKOrderWeb.DTO.InventoryDTO
@{
    ViewData["Title"] = "Inventory Detail";
}

<div class="container pt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Inventory Detail</h4>
        </div>
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-3">Inventory ID</dt>
                <dd class="col-sm-9">@Model.InvID</dd>

                <dt class="col-sm-3">Inventory Name</dt>
                <dd class="col-sm-9">@Model.InvName</dd>

                <dt class="col-sm-3">الاسم بالعربية</dt>
                <dd class="col-sm-9" dir="rtl">@Model.InvName_AR</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.InvLocation</dd>

                <dt class="col-sm-3">Company ID</dt>
                <dd class="col-sm-9">@Model.CompID</dd>

                <dt class="col-sm-3">Brand ID</dt>
                <dd class="col-sm-9">@Model.BrandID</dd>

                @* <dt class="col-sm-3">Branch ID</dt>
                <dd class="col-sm-9">@Model.BranchID</dd>
 *@
                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Last Modified</dt>
                <dd class="col-sm-9">@Model.LastModified.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>

            @if (Model.ItemInventories != null && Model.ItemInventories.Any())
            {
                <h5 class="mt-4">Linked Items (@Model.ItemInventories.Count)</h5>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Item ID</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in Model.ItemInventories)
                        {
                            <tr>
                                <td>@link.ItemID</td>
                                <td>@link.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="row mt-4">
                <div class="col-6">
                    <a asp-controller="Inventory" asp-action="edit" asp-route-id="@Model.InvID" class="btn btn-primary w-100">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Inventory" asp-action="InventoryList" class="btn btn-outline-secondary w-100">Back To List</a>
                </div>
            </div>
        </div>
    </div>
</div>