@model PaymentMethodDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">General Details</h3>
            <dl class="row">

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PaymentMethodID)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.PaymentMethodID)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PaymentMethodName)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.PaymentMethodName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IsActive)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.IsActive)
              


            </dl>
        </div>


        </br>

    </div>
    <a class="btn btn-secondary" asp-action="PaymentMethodList">Back to List</a>
</div>
