@model KiosikDTO

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Store</h4>
<hr />
<partial name="_Notifications" />
<div class="row">
    <form asp-action="Edit">
        <div class="col-md-6">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OldCompID" />
            <input type="hidden" asp-for="KiosikID" />
            <input type="hidden" asp-for="OldBrandID" />
            <input type="hidden" asp-for="OldBranchID" />
            <input type="hidden" asp-for="OldCustomerID" />

            <div class="form-group">
                <label asp-for="KiosikName" class="control-label"></label>
                <input asp-for="KiosikName" class="form-control" />
                <span asp-validation-for="KiosikName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="KiosikRegion" class="control-label"></label>
                <input asp-for="KiosikRegion" class="form-control" />
                <span asp-validation-for="KiosikRegion" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CompID" class="control-label"></label>
                <select id="PreferenceType" asp-for="CompID" class="form-control" asp-items="@Model.CompList">
                    <option value="">Select Company</option>
                </select>
                <span asp-validation-for="CompID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BrandID" class="control-label"></label>
                <select id="PreferenceType2" asp-for="BrandID" class="form-control" asp-items="@Model.BrandList">
                    <option value="">Select Brand</option>
                </select>
                <span asp-validation-for="BrandID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BranchID" class="control-label"></label>
                <select id="BranchID" asp-for="BranchID" class="form-control" asp-items="@Model.BranchList">
                    <option value="">Select Branch</option>
                </select>
                <span asp-validation-for="BranchID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CustomerID" class="control-label"></label>
                <select asp-for="CustomerID" class="form-control" asp-items="@Model.CustomerList">
                    <option value="">Select Customer</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MenuID" class="control-label"></label>
                <select asp-for="MenuID" class="form-control" asp-items="@Model.MenuList">
                    <option value="">Select Menu</option>
                </select>
                <span asp-validation-for="MenuID" class="text-danger"></span>
            </div>

            <div class="form-group pb-3">
                <input type="submit" value="Save" class="btn btn-primary" asp-controller="Kiosik" asp-action="EditPost" />
                | <a class="btn btn-secondary" asp-action="KiosikList">Back to List</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")



    <script type="text/javascript">
        $(document).ready(function () {
            // Company -> Brand
            $("#PreferenceType").change(function () {
                $("#PreferenceType2").empty();
                $.ajax({
                    type: 'POST',
                    url: 'GetPreferenceValues',
                    dataType: 'json',
                    data: { id: $("#PreferenceType").val() },
                    success: function (brands) {
                        $("#PreferenceType2").append('<option value="">Select Brand</option>');
                        $.each(brands, function (i, brand) {
                            $("#PreferenceType2").append('<option value="' + brand.Value + '">' + brand.Text + '</option>');
                        });
                    },
                    error: function (ex) {
                        alert('Failed to retrieve brands. ' + ex);
                    }
                });
                return false;
            });

            // Brand -> Branch
            $("#PreferenceType2").change(function () {
                $("#BranchID").empty();
                $.ajax({
                    type: 'POST',
                    url: 'GetPreferenceValues2',
                    dataType: 'json',
                    data: { id: $("#PreferenceType").val(), id2: $("#PreferenceType2").val() },
                    success: function (branches) {
                        $("#BranchID").append('<option value="">Select Branch</option>');
                        $.each(branches, function (i, branch) {
                            $("#BranchID").append('<option value="' + branch.Value + '">' + branch.Text + '</option>');
                        });
                    },
                    error: function (ex) {
                        alert('Failed to retrieve branches. ' + ex);
                    }
                });
                return false;
            });
        });
    </script>
}
