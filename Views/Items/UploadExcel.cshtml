<form asp-action="UploadExcel" asp-controller="Items" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="excelFile">Upload Excel File</label>
        <input type="file" name="excelFile" accept=".xlsx,.xls" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Import Items</button>
</form>

