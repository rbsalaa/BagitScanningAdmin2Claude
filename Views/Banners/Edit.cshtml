           $(document).ready(function () {
                $('#TargetType').change(function () {
                    var type = $(this).val();
                    var targetSelect = $('#TargetID');
                    targetSelect.empty(); // clear previous options
                    targetSelect.append('<option value="">-- Select Target --</option>');

                    if (type) {
                        $.get('/Banners/GetTargetsByType', { type: type }, function (data) {
                            $.each(data, function (i, item) {
                                targetSelect.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                            });
                        });
                    }
                });
             });

    $(document).ready(function () {

        $("#PreferenceType").change(function () {
            $(".PreferenceType2").empty();
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/TAXGroup/GetPreferenceValues',
                dataType: 'json',
                data: { id2: $(this).val() },
                success: function (data) {
                    $(".PreferenceType2").append('<option value="">Select Brand</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType2").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });

        $(".PreferenceType2").change(function () {
            $(".PreferenceType3").empty();
            $.ajax({
                type: 'POST',
                url: '/TAXGroup/GetPreferenceValues3',
                dataType: 'json',
                data: {
                    id2: $(".PreferenceType2").val(),
                    id3: $("#PreferenceType").val()
                },
                success: function (data) {
                    $(".PreferenceType3").append('<option value="">Select Branch</option>');
                    $.each(data, function (i, item) {
                        $(".PreferenceType3").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                }
            });
        });
    });
</script>