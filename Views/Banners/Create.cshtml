@model BannersDTO

@{
    ViewData["Title"] = "Create";
}



<h1>Create</h1>

<h4>Banners</h4>
<partial name="_Notifications" />
<hr />
<div class="row">
    <partial name="_Notifications" />
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <select id="PreferenceType" asp-for="CompID" class="form-control">
                <option value="">-- Select Company --</option>
                @foreach (var item in Model.CompList)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>

            <select asp-for="BrandID" class="form-control PreferenceType2" disabled>
                <option value="">-- Select Brand --</option>
            </select>

            <select asp-for="BranchID" class="form-control PreferenceType3" disabled>
                <option value="">-- Select Branch --</option>
            </select>
            <div class="form-group">
                <label asp-for="BannerTitle" class="control-label"></label>
                <input asp-for="BannerTitle" class="form-control" />
                <span asp-validation-for="BannerTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TargetType" class="control-label"></label>
                <select asp-for="TargetType" class="form-control" id="TargetType">
                    <option value="">-- Select Target Type --</option>
                    <option value="Item">Item</option>
                    <option value="Category">Category</option>
                </select>
                <span asp-validation-for="TargetType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TargetID" class="control-label"></label>
                <select asp-for="TargetID" class="form-control" id="TargetID">
                    <option value="">-- Select Target --</option>
                </select>
                <span asp-validation-for="TargetID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TargetUrl" class="control-label"></label>
                <input asp-for="TargetUrl" class="form-control" />
                <span asp-validation-for="TargetUrl" class="text-danger"></span>
            </div>

            <div class="form-group pb-3">
                <label asp-for="BannerStartDate" class="control-label"></label>
                <input asp-for="BannerStartDate" class="form-control" />
                <span asp-validation-for="BannerStartDate" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="BannerEndDate" class="control-label"></label>
                <input asp-for="BannerEndDate" class="form-control" />
                <span asp-validation-for="BannerEndDate" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-checkbox" />
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>

           
            <div class="form-group ">

                <div class="custom-file">
                    <input asp-for="@Model.FileAds" type="file" class="custom-file-input fileUpload" accept="image/jpeg" />
                </div>

                <video></video>
            </div>

            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary" asp-controller="Banners" asp-action="createPost" />

                | <a class="btn btn-secondary" asp-action="BannersList">Back to List</a>
            </div>

        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
       $(document).ready(function () {
        $('#TargetType').change(function () {
            var type = $(this).val();
            var targetSelect = $('#TargetID');
            targetSelect.empty(); // clear previous options
            targetSelect.append('<option value="">-- Select Target --</option>');

            if (type) {
                $.get('/Banners/GetTargetsByType', { type: type }, function (data) {
                    $.each(data, function (i, item) {
                        targetSelect.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                });
            }
        });
    });

    var URL = window.URL || window.webkitURL;
    var video = document.getElementsByTagName('video')[0];
    function onChange() {
        var fileItem = document.getElementById('FileAds');
        var files = fileItem.files;
        var file = files[0];
        var url = URL.createObjectURL(file);
        console.log(file);
        console.log(url);
        video.src = url;
        video.load();
        video.onloadeddata = function () {
            video.play();
        }
    }
   
        $(document).ready(function () {

            // When Company is changed
            $("#PreferenceType").change(function () {
                var companyId = $(this).val();
                $(".PreferenceType2").empty().prop('disabled', true);
                $(".PreferenceType3").empty().prop('disabled', true);

                if (companyId) {
                    $.ajax({
                        type: 'POST',
                        url: '/PaymentMethod/GetPreferenceValues',
                        dataType: 'json',
                        data: { id2: companyId },
                        success: function (brands) {
                            $(".PreferenceType2").append('<option value="">-- Select Brand --</option>');
                            $.each(brands, function (i, brand) {
                                $(".PreferenceType2").append('<option value="' + brand.Value + '">' + brand.Text + '</option>');
                            });
                            $(".PreferenceType2").prop('disabled', false);
                        },
                        error: function () {
                            alert('Failed to retrieve brands.');
                        }
                    });
                }
            });

            // When Brand is changed
            $(".PreferenceType2").change(function () {
                var companyId = $("#PreferenceType").val();
                var brandId = $(this).val();
                $(".PreferenceType3").empty().prop('disabled', true);

                if (companyId && brandId) {
                    $.ajax({
                        type: 'POST',
                        url: '/PaymentMethod/GetPreferenceValues3',
                        dataType: 'json',
                        data: { id3: companyId, id2: brandId },
                        success: function (branches) {
                            $(".PreferenceType3").append('<option value="">-- Select Branch --</option>');
                            $.each(branches, function (i, branch) {
                                $(".PreferenceType3").append('<option value="' + branch.Value + '">' + branch.Text + '</option>');
                            });
                            $(".PreferenceType3").prop('disabled', false);
                        },
                        error: function () {
                            alert('Failed to retrieve branches.');
                        }
                    });
                }
            });

        });

</script>
