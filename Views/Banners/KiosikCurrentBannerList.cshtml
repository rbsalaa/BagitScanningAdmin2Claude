@model CarrierDTO
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_Notifications" />
<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-body">
              
              

              
                <!-- end row -->
                <div class="table-responsive mb-4">
                    <table class="table table-hover table-nowrap align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th scope="col" style="width: 50px;">
                                   @* <div class="form-check font-size-16">
                                        <input type="checkbox" class="form-check-input" id="contacusercheck">
                                        <label class="form-check-label" for="contacusercheck"></label>
                                    </div>*@
                                </th>
                                <th scope="col">Banner title</th>
                                <th scope="col">StartDate </th>
                                <th scope="col">EndDate</th>
                                <th scope="col">Banner URL</th>
                              
                                <th scope="col" style="width: 200px;">Stauts</th>
                                      <th scope="col" >UnAssign</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.BannersList)
                            {
                                <tr>
                                    <th scope="row">
                                        
                                    </th>
                                    <td>

                                        @item.BannerTitle
                                    </td>
                                    <td>@item.BannerStartDate</td>
                                    <td>@item.BannerEndDate</td>
                                    <td>@item.BannerURL</td>

                                    <td>
                                        <bold>Current Assigned Banner</bold>
                                    </td>
                                    <td>
                                        <ul class="list-inline mb-0">
                                            <li class="list-inline-item">
                                                <a asp-action="unAssignBannerKiosikListPost" asp-controller="Banners" asp-route-userid="@item.BannerID" asp-route-roleid="@Model.KiosikID" class="px-2 btn-primary"> UnAssign</a>
                                            </li>

                                        </ul>
                                    </td>
                                </tr>
                            }
                      
                          
                        </tbody>
                    </table>
                </div>
              
              
            </div>
        </div>
    </div>
</div>
<!-- end row -->



@section scripts{


}