@model BranchDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">General Details</h3>
            <dl class="row">

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BranchID)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.BranchID)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BrandCode)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.BrandCode)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BranchName)
                </dt>
                <dd class="col-sm-20">
                    @Html.DisplayFor(model => model.BranchName)
                <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.BranchLocation)
                </dt>
                <dd class="col-sm-20">
                        @Html.DisplayFor(model => model.BranchLocation)
                </dd>
                <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.CompanyName)
                </dt>
                <dd class="col-sm-20">
                        @Html.DisplayFor(model => model.CompanyName)
                </dd>
                <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.BrandName)
                </dt>
                <dd class="col-sm-20">
                        @Html.DisplayFor(model => model.BrandName)
                </dd>
               

            </dl>
        </div>
      

      </br>

     </div>
    <a class="btn btn-secondary" asp-action="BranchList">Back to List</a>
</div>
