@model IEnumerable<BranchDTO>
@{
    ViewData["Title"] = "Stores List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">Stores List</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary"  asp-controller="Branch" asp-action="create"><i class="bi bi-plus-circle"></i> &nbsp; Add Branch</a>

        </div>

    </div>
   
    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>

                <th>
                    Branch ID
                </th>
                <th>
                    Branch Code
                </th>
                <th>
                    Branch  Name
                </th>
                <th>
                    Is Active 
                </th>

                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.BranchID

                    </td>
                    <td>
                        @item.BrandCode

                    </td>
                    <td>
                        @item.BranchName

                    </td>

                    <td>
                        @item.IsActive
                    </td>
                    <td class="text-center">
                        <div class="btn-group w-100" role="Store">
                            <a class="btn btn-primary mx-2"  asp-controller="Branch" asp-action="Detail" asp-route-StrId="@item.BranchID" asp-route-CompId="@item.CompID" asp-route-BrndId="@item.BrandID"><i class="bi bi-card-list"></i> &nbsp; Store Details</a>

                            <a class="btn btn-secondary  mx-2 " asp-controller="Branch" asp-action="Edit" asp-route-StrId="@item.BranchID" asp-route-CompId="@item.CompID" asp-route-BrndId="@item.BrandID"><i class="bi bi-pencil-fill"></i> &nbsp; Edit</a>

                            <a class="btn btn-warning  mx-2 " asp-controller="Branch" asp-action="Delete" asp-route-StrId="@item.BranchID" asp-route-CompId="@item.CompID" asp-route-BrndId="@item.BrandID"><i class="bi bi-trash-fill"></i> &nbsp; Delete</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts {





}