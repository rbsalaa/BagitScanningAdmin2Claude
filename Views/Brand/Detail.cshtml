@model BrandDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">@Model.BrandName Details</h3>
        </div>
      

    </div>

    </br>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                
                 <th>
                     ID
                </th>
                <th>
                    Brand Code 
                </th>
                <th>
                    Brand Arabic Name
                </th>
                <th>
                    Company Name
                </th>
                <th>
                    Is Active 
                </th>
               

            </tr>
        </thead>
        <tbody>

            <tr>
             
             
                <td style="width:30%">
                    @Model.BrandID
                </td>
                <td style="width:20%">
                    @Model.BrandCode
                </td>
                <td style="width:20%">
                    @Model.BrandName

                </td>
                  <td style="width:20%">
                    @Model.CompName

                </td>
                <td style="width:20%">
                    @Model.IsActive

                </td>
                 
        </tbody>
    </table>
    <a class="btn btn-secondary" asp-action="BrandList">Back to List</a>
</div>
@section scripts {


}