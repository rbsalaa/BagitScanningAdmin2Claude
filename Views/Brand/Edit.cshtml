@model BrandDTO

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Brand</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BrandID" />
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="BrandCode" class="control-label"></label>
                    <input asp-for="BrandCode" class="form-control" />
                    <span asp-validation-for="BrandCode" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BrandName" class="control-label"></label>
                    <input asp-for="BrandName" class="form-control" />
                    <span asp-validation-for="BrandName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CompID" class="control-label"></label>
                    <select asp-for="CompID" class="form-control" asp-items=@Model.CompList>
                    </select>
                    <span asp-validation-for="CompID" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group pb-3">

                <div class="custom-file mb-3">
                    <input asp-for="@Model.File" type="file" class="custom-file-input fileUpload" accept="image/jpeg" onchange="previewImage(event)" />
                  
                </div>

                <img id="imagePreview"
                     src="@(string.IsNullOrEmpty(Model.BrandPic) ? "#" : Url.Content(Model.BrandPic))"
                     alt="Preview"
                     style="@(string.IsNullOrEmpty(Model.BrandPic) ? "display:none;" : "display:block;") max-width: 200px; margin-top: 10px;" />
            </div>

            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary" asp-controller="Brand" asp-action="EditPost" />
                | <a class="btn btn-secondary"  asp-action="BrandList">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    function previewImage(event) {
       
        const input = event.target;
        const preview = document.getElementById('imagePreview');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
