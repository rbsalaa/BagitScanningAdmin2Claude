@model BrandDTO

@{
    ViewData["Title"] = "Create";
}



<h1>Create</h1>

<h4>Brand</h4>
<hr />
<div class="row">
    <partial name="_Notifications" />
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="BrandCode" class="control-label"></label>
                <input asp-for="BrandCode" class="form-control" />
                <span asp-validation-for="BrandCode" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="BrandName" class="control-label"></label>
                <input asp-for="BrandName" class="form-control" />
                <span asp-validation-for="BrandName" class="text-danger"></span>
            </div>
            <div class="form-group  pb-3">
                <label asp-for="CompID" class="control-label"></label>
                <select asp-for="CompID" class="form-control" asp-items=@Model.CompList>
                </select>
                <span asp-validation-for="CompID" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">

                <div class="custom-file">
                    <input asp-for="@Model.File" type="file" class="custom-file-input fileUpload" accept="image/jpeg" />
                </div>
            </div>
            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary" id="submitBtn" asp-controller="Brand" asp-action="createPost" />
             
                | <a class="btn btn-secondary" asp-action="BrandList">Back to List</a>
            </div>
          
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    $(document).ready(function () {
        $('#fileInput').on('change', function () {
            const fileSelected = $(this).val() !== "";
            $('#submitBtn').prop('disabled', !fileSelected);
        });
    });
</script>