@model IEnumerable<MenuDTO>
@{
    ViewData["Title"] = "Menu List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">Menus List</h3>
        </div>
       

    </div>

    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>


                <th>
                    Menu Name
                </th>


                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.MenuName

                    </td>



                    <td class="text-center">
                        <div class="btn-Roles w-75" role="Roles">
                            <a class="btn btn-primary mx-2" asp-controller="menu" asp-action="AssignItemToCategory" asp-route-id="@item.MenuID"><i class="bi bi-card-list"></i> &nbsp;  Assign Item To Menu</a>

                            <a class="btn  btn-primary mx-2" asp-controller="menu" asp-action="UnassignItemToCategory" asp-route-id="@item.MenuID"><i class="bi bi-card-list"></i> &nbsp;  Current menu Details</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts {





}