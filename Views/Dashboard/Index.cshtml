@section scripts {


    <!-- apexcharts -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>

    <!-- Vector map-->
    <script src="~/assets/libs/jsvectormap/js/jsvectormap.min.js"></script>
    <script src="~/assets/libs/jsvectormap/maps/world-merc.js"></script>

   

    <script src="~/assets/js/pages/dashboard.init.js"></script>

}

  <script>
document.addEventListener("DOMContentLoaded", function () {
    const columnChartEl = document.getElementById("column-chart");

    // Read encoded JSON
    const raw = columnChartEl.dataset.valueKiosk;

    // Decode & parse safely
    const jsonStr = raw.replace(/&quot;/g, '"');
    const kioskData = JSON.parse(jsonStr);

    console.log(kioskData); // ✅ Check structure

    // Prepare chart data
    const labels = kioskData.map(x => x.KiosikName);
    const values = kioskData.map(x => x.OrderCount);

    // Build ApexCharts bar chart
    const options = {
        chart: { type: 'bar', height: 350  , width: '100%'},
        series: [{ name: 'Order Count', data: values }],
        xaxis: { categories: labels },
        // title: { text: 'Kiosk Order Counts' },
        dataLabels: { enabled: true },
        colors: ['#0d6efd']
    };

    const chart = new ApexCharts(columnChartEl, options);
    chart.render();
     // ✅ Handle dynamic resizing if parent changes
    window.addEventListener('resize', () => {
        chart.render(); // ApexCharts automatically recalculates width
    });
});
</script>

