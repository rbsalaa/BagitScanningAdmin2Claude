@model IEnumerable<OrderSummaryDTO>

<div class="container py-4">
    <partial name="_Notifications" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary fw-bold">Orders List</h3>
    </div>

    <!-- Scrollable Table Container -->
    <div class="table-responsive shadow-sm rounded">
        <table id="OrdersTable" class="table table-hover align-middle mb-0">
            <thead class="table-light position-sticky top-0" style="z-index: 1;">
                <tr>
                    <th>Kiosk</th>
                    <th>Aloha Order ID (Order Number)</th>
                    <th>Kiosik Order ID (Ref Num)</th>
                    <th>Total Amount</th>
                    <th>Order Date</th>
                 
                    <th>Status</th>
                    <th class="text-center" style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.KiosikName</td>
                        <td>@item.AlohaOrderId</td>
                        <td>@item.OrderId</td>
                        <td class="fw-semibold text-success">﷼ @item.TotalAmount.ToString("N2")</td>
                        <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                       
                        <td class="text-wrap" style="max-width: 250px;">@item.Status</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-controller="Dashboard" asp-route-id="@item.OrderId"
                               class="btn btn-sm btn-info" title="View Details">
                                <i class="ri-eye-line"></i> More Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .table-hover tbody tr:hover {
            background-color: #f1f7ff;
            transition: 0.3s;
        }

        .table-responsive::-webkit-scrollbar {
            width: 10px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }

            .table-responsive::-webkit-scrollbar-thumb:hover {
                background: #555;
            }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#OrdersTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                searching: true,
                language: {
                    search: "Filter orders:",
                    lengthMenu: "Show _MENU_ entries per page"
                }
            });
        });
    </script>
}
