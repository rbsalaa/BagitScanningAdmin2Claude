@model ModifierDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">@Model.ModifierName Details</h3>
        </div>
      

    </div>

    </br>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                
                 <th>
                     ID
                </th>
                <th>
                    Modifier Name
                </th>
                <th>
                    Modifier Price
                </th>
               
                

            </tr>
        </thead>
        <tbody>

            <tr>
             
             
                <td style="width:30%">
                    @Model.ModifierID
                </td>
                <td style="width:20%">
                    @Model.ModifierName
                </td>
                <td style="width:20%">
                    @Model.ModifierPrice

                </td>
              
                 
        </tbody>
    </table>
    <a class="btn btn-secondary" asp-action="List">Back to List</a>
</div>
