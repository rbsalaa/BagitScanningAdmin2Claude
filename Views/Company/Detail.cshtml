@model CompanyDTO

@{
    ViewData["Title"] = "Details";
}

<div class="container p-3">

    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">@Model.CompName Details</h3>
        </div>
      

    </div>

    </br>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                
                 <th>
                     ID
                </th>
                <th>
                    Company  Name
                </th>
                <th>
                    Code 
                </th>
               

            </tr>
        </thead>
        <tbody>

            <tr>
             
             
                <td style="width:30%">
                    @Model.CompID
                </td>
                <td style="width:20%">
                    @Model.CompName
                </td>
                <td style="width:20%">
                    @Model.CompCode

                </td>
                 
        </tbody>
    </table>
    <a class="btn btn-secondary"  asp-action="CompanyList">Back to List</a>
</div>
@section scripts {





}