@model CompanyDTO

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Company</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CompID" />
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="CompName" class="control-label"></label>
                    <input asp-for="CompName" class="form-control"  />
                    <span asp-validation-for="CompName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CompCode" class="control-label"></label>
                    <input asp-for="CompCode" class="form-control" />
                    <span asp-validation-for="CompCode" class="text-danger"></span>
                </div>
            </div>
            

            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary"  asp-controller="Company" asp-action="EditPost" />
                | <a class="btn btn-secondary" asp-action="CompanyList">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


}
