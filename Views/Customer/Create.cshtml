@model CustomerDTO

@{
    ViewData["Title"] = "Create";
}



<h1>Create</h1>

<h4>Brand</h4>
<hr />
<div class="row">
    <partial name="_Notifications" />
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="CustomerName" class="control-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="CustomerLocation" class="control-label"></label>
                <input asp-for="CustomerLocation" class="form-control" />
                <span asp-validation-for="CustomerLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerMail" class="control-label"></label>
                <input asp-for="CustomerMail" class="form-control" />
                <span asp-validation-for="CustomerMail" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="CustomerPhone" class="control-label"></label>
                <input asp-for="CustomerPhone" class="form-control" />
                <span asp-validation-for="CustomerPhone" class="text-danger"></span>
            </div>
           
           
           
            <div class="form-group  pb-3">
                <input type="submit" value="Save" class="btn btn-primary"  asp-controller="Customer" asp-action="createPost" />
             
                | <a class="btn btn-secondary" asp-action="CustomerList">Back to List</a>
            </div>
          
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
