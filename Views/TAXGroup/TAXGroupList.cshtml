@model IEnumerable<TAXGroupDTO>
@{
    ViewData["Title"] = "TAXGroups List";
}

<div class="container p-3">
    <partial name="_Notifications" />
    <div class="row pt-4">
        <div class="col-6">
            <h3 class="text-primary">TAXGroups List</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-primary" asp-controller="TAXGroup" asp-action="create"><i class="bi bi-plus-circle"></i> &nbsp; Add TAXGroup</a>

        </div>

    </div>

    </br>
    <table id="UserTable" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
              
                <th>
                    TAXGroup ID
                </th>
                <th>
                TAXGroup Name
                </th>
                <th>
                    TAXGroup Percintage
                </th>
                <th>
                  Is Active
                </th>

                <th class="text-center">
                    Operations
                </th>



            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td >
                        @item.TAXID

                    </td>
                    <td >
                        @item.TAXName

                    </td>
                    <td>
                        @item.TAXPercentage

                    </td>

                    <td >
                        @item.IsActive

                    </td>
                   
                    <td class="text-center">
                        <div class="btn-group w-75" role="TAXGroup">
                            <a class="btn btn-primary mx-2"  asp-controller="TAXGroup" asp-action="Detail" asp-route-id="@item.TAXID"><i class="bi bi-card-list"></i> Details</a>

                            <a class="btn btn-secondary  mx-2 " asp-controller="TAXGroup" asp-action="Edit" asp-route-id="@item.TAXID"><i class="bi bi-pencil-fill"></i>  Edit</a>

                            <a class="btn btn-warning  mx-2 " asp-controller="TAXGroup" asp-action="Delete" asp-route-id="@item.TAXID"><i class="bi bi-trash-fill"></i> Delete</a>




                        </div>

                    </td>



                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts {





}